{
  "name": "technest",
  "private": false,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@technest/backend",
    "backend:dev": "turbo dev --filter=@technest/backend",
    "storefront:dev": "turbo dev --filter=@technest/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0",
      "@graphql-tools/utils@^12": "^12.0.1",
      "@grpc/grpc-js@^1": "^1.14.5",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^5": "^5.0.12",
      "compression@^1": "^1.8.2",
      "fast-uri@^3": "^3.1.8",
      "js-yaml@^3": "^3.15.2",
      "js-yaml@^4": "^4.3.2",
      "proxy-addr@^2": "^2.0.8",
      "source-map-js@^1": "^1.2.2"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
