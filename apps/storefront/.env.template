# Tech Nest storefront environment. Copy to .env.local and fill in. Never commit it.
# Replace every "N" with your engineer number (1-4).
# The dev port is NOT read from this file: start with `PORT=800N pnpm dev`.

# Publishable API key from YOUR backend (admin > Settings > Publishable API Keys,
# or printed by the seed script). Required for every store API call.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Your backend URL (900N)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:900N

# Default region country code
NEXT_PUBLIC_DEFAULT_REGION=gb

# Base URL of this storefront (800N)
NEXT_PUBLIC_BASE_URL=http://localhost:800N

# Stripe publishable key (pk_test_... in dev) - E2
NEXT_PUBLIC_STRIPE_KEY=

# Cloudflare Turnstile site key. Dev test key that always passes:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Public hostname of product images (R2 / CDN) for next/image remotePatterns
# (E3: wire into next.config.js images.remotePatterns)
NEXT_PUBLIC_IMAGE_HOSTNAME=

# Sentry (E4)
NEXT_PUBLIC_SENTRY_DSN=

NODE_ENV=development
