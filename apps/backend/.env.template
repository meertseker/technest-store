# Tech Nest backend environment. Copy to .env and fill in. Never commit .env.
# Values below are for LOCAL DEV. Replace every "EN" with your engineer number (1-4).

# --- Server ---------------------------------------------------------------
# Port for the API and admin (/app). E1=9001, E2=9002, E3=9003, E4=9004
PORT=900N
# Public URL of this backend (used by the admin build and in links)
MEDUSA_BACKEND_URL=http://localhost:900N

# --- CORS -----------------------------------------------------------------
# Storefront origin(s). Dev: your storefront port (800N)
STORE_CORS=http://localhost:800N
# Admin origin(s). Dev: the backend itself serves /app
ADMIN_CORS=http://localhost:900N,http://localhost:5173
# Auth origin(s): storefront + admin
AUTH_CORS=http://localhost:800N,http://localhost:900N,http://localhost:5173

# --- Secrets (dev values only; production uses long random strings) -------
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# --- Data -----------------------------------------------------------------
# Shared dev Postgres (docker-compose.dev.yml). Your own database: technest_eN
DATABASE_URL=postgres://postgres:postgres@localhost:5432/technest_eN
# Name used by `medusa db:create`/tests; keep it equal to the DB in DATABASE_URL
DB_NAME=technest_eN
# Shared dev Redis. Use a distinct DB index per engineer to avoid clashes: /1../4
REDIS_URL=redis://localhost:6379/N

# --- Payments (E2) ----------------------------------------------------------
# Stripe secret key (sk_test_... in dev). Never log or commit.
STRIPE_API_KEY=
# Stripe webhook signing secret (whsec_...), from `stripe listen` in dev
STRIPE_WEBHOOK_SECRET=

# --- Email (E2) ------------------------------------------------------------
# Dev: Mailpit on localhost:1025 (web UI http://localhost:8025), no auth
SMTP_HOST=localhost
SMTP_PORT=1025
# true = implicit TLS (port 465). Leave false for 587/STARTTLS and Mailpit.
SMTP_SECURE=false
# Require STARTTLS when SMTP_SECURE=false. Defaults to true in production.
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
# From address for all outgoing mail
MAIL_FROM="Tech Nest <hello@technest.co.uk>"
# Where customer replies go
MAIL_REPLY_TO=hello@technest.co.uk
# Shop inbox for internal alerts (new orders, trade applications, low stock)
SHOP_NOTIFY_EMAIL=hello@technest.co.uk

# --- Photos (E4) -----------------------------------------------------------
# rembg HTTP server (BiRefNet-general model) - photo-worker container
PHOTO_WORKER_URL=http://localhost:7000
# Claude API key for product text from a photo
ANTHROPIC_API_KEY=

# --- File storage ---------------------------------------------------------
# Leave S3_* empty in dev to use the local file provider (./static).
# Production: Cloudflare R2 via Medusa's S3 file provider.
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=

# --- Anti-abuse (E1 repair booking) ---------------------------------------
# Cloudflare Turnstile secret. Dev test key that always passes:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Monitoring (E4) --------------------------------------------------------
SENTRY_DSN=
