# /opt/technest/.env on the server (chmod 600). NEVER commit the filled-in copy.
# Every value marked REQUIRED must be set; see DEPLOY.md section 5 for where each comes from.
# Random values: openssl rand -hex 32   (POSTGRES_PASSWORD must be hex-only)

# --- Stack -------------------------------------------------------------------
SHOP_DOMAIN=technest.co.uk                 # REQUIRED (staging: your staging domain)
GHCR_OWNER=                                # REQUIRED, lower-case GitHub owner
IMAGE_TAG=main                             # written by deploy.yml; don't edit by hand
ACME_EMAIL=hello@technest.co.uk
# On a 4 GB box (staging, restore drill, or a small production server):
# COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml

# --- Secrets -----------------------------------------------------------------
POSTGRES_PASSWORD=                         # REQUIRED, hex only
JWT_SECRET=                                # REQUIRED
COOKIE_SECRET=                             # REQUIRED

# --- Files: Cloudflare R2 bucket technest-media -------------------------------
S3_FILE_URL=https://media.technest.co.uk   # REQUIRED
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com   # REQUIRED
S3_BUCKET=technest-media                   # REQUIRED
S3_ACCESS_KEY_ID=                          # REQUIRED (token technest-media-rw)
S3_SECRET_ACCESS_KEY=                      # REQUIRED

# --- Backups: R2 bucket technest-backups (separate token) ---------------------
BACKUP_BUCKET=technest-backups
BACKUP_S3_ACCESS_KEY_ID=                   # REQUIRED for backups (token technest-backups-rw)
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_AT=03:15
BACKUP_RETENTION_DAYS=30

# --- Payments (E2) -------------------------------------------------------------
STRIPE_API_KEY=                            # REQUIRED in production (sk_test_ on staging)
STRIPE_WEBHOOK_SECRET=                     # REQUIRED in production

# --- Email: Resend over SMTP ------------------------------------------------------
# The domain of MAIL_FROM must be verified in Resend. See DEPLOY.md section 11.
# Defaults (no need to set): SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USER=resend
SMTP_PASS=                                 # REQUIRED: the Resend API key (re_...)
MAIL_FROM=Tech Nest <orders@technest.co.uk>
MAIL_REPLY_TO=hello@technest.co.uk         # customer replies; forwarded by Cloudflare Email Routing
SHOP_NOTIFY_EMAIL=hello@technest.co.uk     # shop alerts (new order, trade, repair, low stock)

# --- Photos and Quick Add (E4 / C1) ---------------------------------------------
FAL_KEY=                                   # fal.ai key for background removal (server-side only). Empty = photo processing off
ANTHROPIC_API_KEY=                         # optional: empty = Quick Add works without AI suggestions (server-side only)
QUICK_ADD_AI_LIMIT_PER_HOUR=60             # photo analyses per admin user per hour
QUICK_ADD_AI_TIMEOUT_MS=60000              # timeout per Claude attempt (ms)

# --- Anti-abuse (E1) --------------------------------------------------------------
TURNSTILE_SECRET_KEY=

# --- Monitoring (E4) -------------------------------------------------------------
SENTRY_DSN_BACKEND=                        # optional: empty = Sentry off
SENTRY_DSN_STOREFRONT=
