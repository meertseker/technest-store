# /opt/technest/.env on the server (chmod 600). NEVER commit the filled-in copy.
# Every value marked REQUIRED must be set; see DEPLOY.md section 5 for where each comes from.
# Random values: openssl rand -hex 32   (POSTGRES_PASSWORD and REDIS_PASSWORD must be hex-only)

# --- Stack -------------------------------------------------------------------
SHOP_DOMAIN=technestlondon.co.uk                 # REQUIRED (staging: your staging domain)
GHCR_OWNER=                                # REQUIRED, lower-case GitHub owner
IMAGE_TAG=                                 # written by the Deploy workflow (<env>-<commit>-<run>); leave empty before the first deploy
ACME_EMAIL=hello@technestlondon.co.uk
# On a 4 GB box (staging, restore drill, or a small production server):
# COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml

# --- Secrets -----------------------------------------------------------------
POSTGRES_PASSWORD=                         # REQUIRED, hex only
REDIS_PASSWORD=                            # REQUIRED, hex only (Redis refuses clients without it)
JWT_SECRET=                                # REQUIRED
COOKIE_SECRET=                             # REQUIRED

# --- Files: Cloudflare R2 bucket technest-media -------------------------------
S3_FILE_URL=https://media.technestlondon.co.uk   # REQUIRED
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com   # REQUIRED
S3_BUCKET=technest-media                   # REQUIRED
S3_ACCESS_KEY_ID=                          # REQUIRED (token technest-media-rw)
S3_SECRET_ACCESS_KEY=                      # REQUIRED

# --- Backups: R2 bucket technest-backups (separate token) ---------------------
BACKUP_BUCKET=technest-backups
BACKUP_S3_ACCESS_KEY_ID=                   # REQUIRED for backups (token technest-backups-rw)
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_EVERY_MINUTES=60                    # also the most data a lost disk can cost (up to this many minutes of orders)
BACKUP_HEARTBEAT_URL=                      # REQUIRED in practice: dead-man switch URL (e.g. healthchecks.io); empty = a failed backup is silent
BACKUP_AGE_RECIPIENT=                      # optional: age public key (age1...); keep the private key off this server
BACKUP_RETENTION_DAYS=30

# --- Personal data retention (daily purge job, defaults shown) -------------------
REPAIR_RETENTION_DAYS=365                  # repair bookings (any status) are removed this many days after their last update
TRADE_RETENTION_DAYS=365                   # rejected/revoked trade applications are removed this many days after the decision

# --- Payments (E2) -------------------------------------------------------------
STRIPE_API_KEY=                            # REQUIRED in production (sk_test_ on staging)
STRIPE_WEBHOOK_SECRET=                     # REQUIRED in production

# --- Email: Resend over SMTP ------------------------------------------------------
# The domain of MAIL_FROM must be verified in Resend. See DEPLOY.md section 11.
# Defaults (no need to set): SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USER=resend
SMTP_PASS=                                 # REQUIRED: the Resend API key (re_...)
MAIL_FROM=Tech Nest <orders@technestlondon.co.uk>
MAIL_REPLY_TO=hello@technestlondon.co.uk         # customer replies; forwarded by Cloudflare Email Routing
SHOP_NOTIFY_EMAIL=hello@technestlondon.co.uk     # shop alerts (new order, trade, repair, low stock)
RESEND_WEBHOOK_SECRET=                     # REQUIRED in practice: Resend -> Webhooks -> signing secret (whsec_...), events email.bounced + email.complained to https://api.<domain>/hooks/email/resend; empty = bounces and spam complaints reach nobody (DEPLOY.md 11.2)
NOTIFICATION_RETENTION_DAYS=90             # stored email attempts (recipient address, template, status) are deleted after this many days; minimum 7

# --- Photos and Quick Add (E4 / C1) ---------------------------------------------
FAL_KEY=                                   # fal.ai key for background removal (server-side only). Empty = photo processing off
PHOTO_TIMEOUT_MS=90000                     # deadline per photo for the fal call incl. one retry (ms); keep under the proxy's ~120 s cut-off
ANTHROPIC_API_KEY=                         # optional: empty = Quick Add works without AI suggestions (server-side only)
QUICK_ADD_AI_LIMIT_PER_HOUR=60             # photo analyses per admin user per hour
QUICK_ADD_AI_TIMEOUT_MS=60000              # timeout per Claude attempt (ms)
QUICK_ADD_AI_DEADLINE_MS=90000             # whole analyse call incl. one retry (ms); keep under the proxy's ~120 s cut-off

# --- Anti-abuse (E1) --------------------------------------------------------------
TURNSTILE_SECRET_KEY=

# --- Monitoring (E4) -------------------------------------------------------------
# All three are REQUIRED in practice (DEPLOY.md section 9, docs/ops/uptime-and-sentry.md). The stack starts
# without them, but then a dead worker, a failed payment capture or failing email reaches nobody.
SENTRY_DSN_BACKEND=                        # failed jobs, subscribers and emails are reported here; empty = Sentry off
SENTRY_DSN_STOREFRONT=
WORKER_HEARTBEAT_URL=                      # dead-man switch URL (e.g. healthchecks.io, period 5 min, grace 15 min); empty = a dead or stuck worker is silent

# Sales page visitors: a Cloudflare API token with only "Analytics Read" on the zone, and the zone id.
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ZONE_ID=
