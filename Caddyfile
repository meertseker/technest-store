# Tech Nest reverse proxy. Automatic HTTPS; Cloudflare proxies in front (SSL mode: Full (strict)).
{
	email {$ACME_EMAIL}
	servers {
		# Trust Cloudflare so {client_ip} and logs see the real visitor IP.
		# Ranges from https://www.cloudflare.com/ips/ (re-check yearly; see DEPLOY.md).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(access_log) {
	log {
		output stdout
		format json
	}
}

# The shop's access log must never hold a Stripe client secret: Stripe sends the shopper back
# from 3-D Secure and Klarna to /api/payment-return?payment_intent_client_secret=..., and a
# secret is not something logs should keep. The query is logged with those two values
# replaced; everything else about the request stays (infra/caddy/test-caddyfile.sh checks it).
(shop_access_log) {
	log {
		output stdout
		format filter {
			wrap json
			request>uri query {
				replace payment_intent_client_secret REDACTED
				replace payment_intent REDACTED
			}
		}
	}
}

{$SHOP_DOMAIN} {
	import common
	import shop_access_log
	# The storefront forwards CF-Connecting-IP to the backend (sign-in, registration and repair
	# booking limits): always overwrite it so a client that bypasses Cloudflare can't choose its own IP.
	reverse_proxy storefront:8000 {
		header_up CF-Connecting-IP {client_ip}
	}
}

www.{$SHOP_DOMAIN} {
	redir https://{$SHOP_DOMAIN}{uri} permanent
}

# Store API + Stripe webhooks (/hooks/payment/stripe_stripe). The admin dashboard, the admin
# API and admin sign-in are served on admin.<domain> only: here they do not exist, so the
# protection in front of the admin host (Cloudflare Access, DEPLOY.md) cannot be walked around.
api.{$SHOP_DOMAIN} {
	import common
	import access_log
	@adminOnly path /admin /admin/* /app /app/* /panel /panel/* /auth/user/*
	respond @adminOnly 404
	reverse_proxy server:9000 {
		# The API throttles by CF-Connecting-IP. Overwrite it with the client IP Caddy
		# resolved (trusted_proxies above), so a request that bypasses Cloudflare can't spoof it.
		header_up CF-Connecting-IP {client_ip}
	}
}

# Admin dashboard, same origin as /admin and /auth, so session cookies need no cross-site setup.
admin.{$SHOP_DOMAIN} {
	import common
	import access_log
	header X-Frame-Options "DENY"
	# The shop panel (/panel) is the owner's start page; Medusa's dashboard stays at /app.
	redir / /panel/ 302
	@notAdmin not path /app* /panel /panel/* /admin/* /auth/* /static/* /health
	respond @notAdmin 404
	reverse_proxy server:9000 {
		# Admin sign-in is throttled by this header too: same rule as on the API site.
		header_up CF-Connecting-IP {client_ip}
	}
}
