# Tech Nest reverse proxy. Automatic HTTPS; Cloudflare proxies in front (SSL mode: Full (strict)).
{
	email {$ACME_EMAIL}
	servers {
		# Trust Cloudflare so {client_ip} and logs see the real visitor IP.
		# Ranges from https://www.cloudflare.com/ips/ (re-check yearly; see DEPLOY.md).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output stdout
		format json
	}
}

{$SHOP_DOMAIN} {
	import common
	reverse_proxy storefront:8000
}

www.{$SHOP_DOMAIN} {
	redir https://{$SHOP_DOMAIN}{uri} permanent
}

# Store API + Stripe webhooks. The admin UI lives on admin.<domain>.
api.{$SHOP_DOMAIN} {
	import common
	redir /app* https://admin.{$SHOP_DOMAIN}{uri} permanent
	reverse_proxy server:9000 {
		# The API rate limits by CF-Connecting-IP. Overwrite it with the client IP Caddy
		# resolved (trusted_proxies above), so a request that bypasses Cloudflare can't spoof it.
		header_up CF-Connecting-IP {client_ip}
	}
}

# Admin dashboard, same origin as /admin and /auth, so session cookies need no cross-site setup.
admin.{$SHOP_DOMAIN} {
	import common
	header X-Frame-Options "DENY"
	redir / /app permanent
	@notAdmin not path /app* /admin/* /auth/* /static/* /health
	respond @notAdmin 404
	reverse_proxy server:9000
}
